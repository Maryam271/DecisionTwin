# Copy this file to .env and configure with your active Nebius Token Factory credentials.
# Note: Endpoint and Model ID are unverified defaults and must match your Nebius account access.
NEBIUS_API_KEY=YOUR_NEBIUS_API_KEY_HERE
NEBIUS_ENDPOINT=https://api.tokenfactory.nebius.com/v1/chat/completions
NEBIUS_MODEL=nebius/nvidia/nemotron-3.5-super-vl